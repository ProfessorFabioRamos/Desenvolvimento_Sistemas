abstract class Animal{
    public string Nome{get;init;} = "";

    public abstract void EmitirSom();

    public virtual void Comer(){
        Console.WriteLine($"Animal {Nome} está comendo");
    }
}

class Cachorro : Animal{
    private string raca = "";
    public string Raca{
        get{return raca;}
        set{raca = value;}
    }

    public Cachorro(string nomeAnimal, string racaCachorro){
        Nome = nomeAnimal;
        Raca = racaCachorro;
    }

    // É obrigado pela classe base a implementar
    public override void EmitirSom(){
        Console.WriteLine("Au Au");
    }

    public override void Comer(){
        base.Comer();
        Console.WriteLine($"{Nome} está comendo ração.");
    }
}

class Program{
    public static void Main(string[] args){       
        Cachorro cachorro_1 = new Cachorro("Jorge","Lulu");
        //cachorro_1.Nome = "Totó";
        cachorro_1.Raca = "Basset Hound";
        cachorro_1.EmitirSom();
        cachorro_1.Comer();
        Console.WriteLine($"Nome do cachorro: {cachorro_1.Nome}\nRaça: {cachorro_1.Raca}");
    }
}
