abstract class Animal{
    public string Nome {protected get;init;} = "";

    public abstract void EmitirSom();

    public virtual void Comer(){
        Console.WriteLine($"{Nome} está comendo.");
    }
}

class Cachorro : Animal{
    private string raca ="";

    public string Raca{
        get{return raca;}
        set{raca = value;}
    }

    public Cachorro(string nomeDoAnimal, string racaDoCachorro){
        Nome = nomeDoAnimal;
        raca = racaDoCachorro;
    }

    //Sobrescrita Polimorfismo Dinâmico
    public override void EmitirSom(){
        Console.WriteLine("Au Au");
    }

    public override void Comer(){
        base.Comer();
        Console.WriteLine($"{Nome} da raça {Raca} está comendo ração.");
    }
}

class Program{
    public static void Main(string[] args){
        Cachorro cachorro_1 = new Cachorro("Jorge","Lulu");
        //cachorro_1.Nome = "Totó";
        cachorro_1.Raca = "Basset Hound";
        cachorro_1.EmitirSom();
        cachorro_1.Comer();
